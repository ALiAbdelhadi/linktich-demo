# ==========================================
# Environment Configuration - Linktich Platform
# ==========================================

NODE_ENV="development"
PORT=3000

# Next.js App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------
# Database Connection (PostgreSQL / Supabase)
# ------------------------------------------
# Pooled connection string (used by Prisma Client in Serverless/Edge)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection string (used by Prisma CLI for migrations)
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# ------------------------------------------
# Supabase Configuration (Auth & Storage)
# ------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOi..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi..."

# ------------------------------------------
# Authentication (NextAuth / JWT)
# ------------------------------------------
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="super-secret-key-min-32-chars-long"

# ------------------------------------------
# Egyptian Payment Gateway (Paymob Accept)
# For Center & Teacher B2B SaaS Subscriptions
# ------------------------------------------
# Paymob API Base URL (Production / Sandbox)
PAYMOB_BASE_URL="https://accept.paymob.com/api"

# Paymob Account API Key (from Dashboard -> Settings -> Account Info)
PAYMOB_API_KEY="linktich_paymob_api_key_sample"

# Integration IDs (from Dashboard -> Developers -> Payment Integrations)
PAYMOB_CARD_INTEGRATION_ID="123456" # Online Card (Visa / Mastercard / Meeza)
PAYMOB_WALLET_INTEGRATION_ID="123457" # Mobile Wallets (Vodafone Cash, Orange, WE, Etisalat)

# Payment Iframe ID (from Dashboard -> Developers -> Iframes)
PAYMOB_IFRAME_ID="12345"

# HMAC Secret (from Dashboard -> Settings -> Account Info -> HMAC Secret)
# Used to verify SHA512 transaction callback signatures
PAYMOB_HMAC_SECRET="linktich_paymob_hmac_secret_sample"
